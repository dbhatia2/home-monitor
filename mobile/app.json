{
  "expo": {
    "name": "Home Deals",
    "slug": "home-monitor-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "homedeals",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dbhatia.homedeals"
    },
    "android": {
      "package": "com.dbhatia.homedeals",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090F",
          "resizeMode": "contain",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
