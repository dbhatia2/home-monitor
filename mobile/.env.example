# Base URL of the Next.js API in ../ui
#
# Leaving this as localhost is fine. When the app is opened from a QR code on a
# real phone, lib/api.ts detects the loopback address and automatically swaps in
# the Metro host's LAN IP, keeping this port. Set a real URL only to override
# that (for example a tunnel).
#
# Local dev on this machine:      http://localhost:3200
# Phone on the same WiFi:         auto-detected, or http://<mac-lan-ip>:3200
# Through ngrok:                  https://<subdomain>.ngrok-free.app
#
# EXPO_PUBLIC_ prefixed vars are inlined into the bundle at build time, so this
# is not a place for real secrets. The API key here only gates a personal,
# read-only listings feed.
EXPO_PUBLIC_API_URL=http://localhost:3200

# Must match API_KEY in ../ui/.env.local
EXPO_PUBLIC_API_KEY=
