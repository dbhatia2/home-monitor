{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3200"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://home-monitor-xyz.vercel.app",
        "EXPO_PUBLIC_API_KEY": "${API_KEY}"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://home-monitor-xyz.vercel.app",
        "EXPO_PUBLIC_API_KEY": "${API_KEY}"
      },
      "ios": {
        "bundleIdentifier": "com.dbhatia.homedeals"
      },
      "android": {
        "package": "com.dbhatia.homedeals"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
