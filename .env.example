# PostgreSQL Database (use POSTGRES_URL for Supabase, or individual DB_* for local)
POSTGRES_URL=postgresql://postgres.xxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# OR for local PostgreSQL:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=monitor
# DB_PASS=monitor123
# DB_NAME=home_monitor

# Email notifications
EMAIL_FROM=your-email@gmail.com
EMAIL_PASS=your-app-password

# Scraper settings
DB_WRITE=true
